# Optional live JARVIS gateway integration (server-side only).
# Leave both blank when the gateway is not running; this does not affect admin storage.
JARVIS_AI_URL=
JARVIS_AI_KEY=

# Public site origin used for canonical URLs and sitemap generation.
# This local default is for development only; replace it with the real HTTPS origin in production.
VITE_SITE_URL=http://localhost:5173

# Server-side AI provider configuration.
# Copy this file to .env.local for local development and insert your own key.
# NEVER commit .env.local or any real API key.
OPENAI_API_KEY=

# Private portfolio administration (server-side only; never use VITE_ prefixes).
# Use a long, unique password and a separate random session-signing secret.
# Generate a secret locally with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Configure both values in local .env.local AND deployment environment secrets.
PORTFOLIO_ADMIN_PASSWORD=
PORTFOLIO_ADMIN_SESSION_SECRET=

# Resume storage is a Cloudflare R2 binding named RESUME_BUCKET, configured in wrangler.jsonc.
# Do not store resume files in public/ or commit them to this repository.
